    name = "Total Kills",
    prefix = "",
    value = getgenv().KillCount,
    maxValue = 99999 
})

local function updateKillUI(newAmount)
    getgenv().KillCount = newAmount
    killStat:Set(getgenv().KillCount)
end

local cachedHealth = {}
local processedVictims = {}

local function trackLeaderstats(folder)
    local killKeywords = {"kills", "kos", "wipeouts", "knockouts", "frags", "defeats", "streaks", "bounty"}
    
    local function checkValue(child)
        if child:IsA("ValueBase") then
            local childName = child.Name:lower()
            for _, keyword in ipairs(killKeywords) do
                if childName:find(keyword) then
                    child.Changed:Connect(function(newValue)
                        if newValue == 0 then
                            updateKillUI(0) 
                        elseif newValue > getgenv().KillCount then
                            updateKillUI(newValue) 
                        end
                    end)
                    if child.Value > getgenv().KillCount then
                        updateKillUI(child.Value)
                    end
                    break
                end
            end
        end
    end
    for _, child in ipairs(folder:GetChildren()) do checkValue(child) end
    folder.ChildAdded:Connect(checkValue)
end

local function setupLocalPlayerStats()
    local function onChildAdded(child)
        if child.Name == "leaderstats" then trackLeaderstats(child) end
    end
    local currentLeaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if currentLeaderstats then trackLeaderstats(currentLeaderstats) end
    LocalPlayer.ChildAdded:Connect(onChildAdded)
end
task.spawn(setupLocalPlayerStats)

task.spawn(function()
    while task.wait(0.1) do 
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        
        if myRoot then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    local char = player.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    
                    if hum and root then
                        local pName = player.Name
                        local currentHealth = hum.Health
                        local previousHealth = cachedHealth[pName] or 100
                        
                        cachedHealth[pName] = currentHealth
                        
                        if (currentHealth <= 0 and previousHealth > 0) or (not char.Parent and previousHealth < 75) then
                            if not processedVictims[pName] then
                                
                                processedVictims[pName] = true
                                task.delay(3, function() processedVictims[pName] = nil end)
                                
                                local distance = (myRoot.Position - root.Position).Magnitude
                                if distance <= 28 then
                                    local current = getgenv().KillCount
                                    task.wait(0.05) 
                                    if getgenv().KillCount == current then
                                        updateKillUI(getgenv().KillCount + 1)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

