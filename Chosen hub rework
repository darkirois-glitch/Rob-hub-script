getgenv().FlyEnabled = false
getgenv().FlySpeed = 50 

local flyConnection = nil
local bodyVelocity = nil
local bodyGyro = nil

local function startFlying()
    local character = LocalPlayer.Character
    if not character then return end
    local rootPart = character:WaitForChild("HumanoidRootPart", 5)
    local humanoid = character:WaitForChild("Humanoid", 5)
    if not rootPart or not humanoid then return end
    
    if bodyVelocity then bodyVelocity:Destroy() end
    if bodyGyro then bodyGyro:Destroy() end
    if flyConnection then flyConnection:Disconnect() end
    
    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.P = 9e4
    bodyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
    bodyGyro.cframe = rootPart.CFrame
    bodyGyro.Parent = rootPart

    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.velocity = Vector3.new(0, 0, 0)
    bodyVelocity.maxForce = Vector3.new(9e9, 9e9, 9e9)
    bodyVelocity.Parent = rootPart
    
    flyConnection = RunService.RenderStepped:Connect(function()
        if not getgenv().FlyEnabled or not character:IsDescendantOf(workspace) or not rootPart:IsDescendantOf(workspace) then
            if flyConnection then flyConnection:Disconnect() flyConnection = nil end
            return
        end

        local camera = workspace.CurrentCamera
        local targetVelocity = Vector3.new(0, 0, 0)
        
        local moveDirection = humanoid.MoveDirection
        
        if moveDirection.Magnitude > 0 then
            
            local cameraLook = camera.CFrame.LookVector
            local flatLook = Vector3.new(cameraLook.X, 0, cameraLook.Z).Unit
            
            local cameraRight = camera.CFrame.RightVector
            local flatRight = Vector3.new(cameraRight.X, 0, cameraRight.Z).Unit
            
            local forwardAmount = moveDirection:Dot(flatLook)
            local rightAmount = moveDirection:Dot(flatRight)
            
            local verticalForce = 0
            if math.abs(forwardAmount) > 0.1 then
                verticalForce = cameraLook.Y * forwardAmount
            end
            
            local rawCombinedDirection = (flatLook * forwardAmount) + (flatRight * rightAmount) + Vector3.new(0, verticalForce, 0)
            
            if rawCombinedDirection.Magnitude > 0 then
                targetVelocity = rawCombinedDirection.Unit * getgenv().FlySpeed
            end
        end
        
        bodyGyro.cframe = camera.CFrame
        bodyVelocity.velocity = targetVelocity
    end)
end

local function stopFlying()
    if flyConnection then flyConnection:Disconnect() flyConnection = nil end
    if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
    if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
end

if getgenv().FlyResetConnection then getgenv().FlyResetConnection:Disconnect() end
getgenv().FlyResetConnection = LocalPlayer.CharacterAdded:Connect(function()
