local function destroyVisuals(data)
    if not data then
        return
    end

    if data.RenderConnection then
        data.RenderConnection:Disconnect()
        data.RenderConnection = nil
    end

    if data.Highlight then
        data.Highlight:Destroy()
        data.Highlight = nil
    end

    if data.Billboard then
        data.Billboard:Destroy()
        data.Billboard = nil
    end

    if data.Box then
        data.Box:Destroy()
        data.Box = nil
    end

    if data.Tracer then
        data.Tracer:Destroy()
        data.Tracer = nil
    end
end

