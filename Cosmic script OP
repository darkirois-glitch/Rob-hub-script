local function CleanupAll()
    for _, anim in ipairs(currentAnimations) do
        pcall(function()
            if anim and anim.Stop then
                anim:Stop()
            end
        end)
    end
    currentAnimations = {}
    
    for _, npc in ipairs(npcList) do
        pcall(function()
            if npc and npc.Parent then
                npc:Destroy()
            end
        end)
    end
    npcList = {}
    
    local toDelete = {}
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") and obj.Name and string.find(obj.Name, "_NPC") then
            table.insert(toDelete, obj)
        end
    end
    for _, obj in ipairs(toDelete) do
        pcall(function()
            obj:Destroy()
        end)
    end
    
    if originalCharacter and originalCharacter.Parent then
        pcall(function()
            for _, v in ipairs(originalCharacter:GetDescendants()) do
                if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
                    v.Transparency = 0
                    v.CanCollide = true
                end
            end
        end)
    end
    
