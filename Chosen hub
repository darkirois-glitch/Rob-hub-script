        task.delay(0.5, function()
            if getgenv().EspEnabled
                and player.Character == character
                and character:IsDescendantOf(workspace)
            then
                createESP(player, character)
            end
        end)

        return
    end

    local data = getgenv().ESPData[player]

    if not data then
        data = {}
        getgenv().ESPData[player] = data
    end

    destroyVisuals(data)

    data.Character = character
    data.RootPart = rootPart
    data.Head = head
    data.Humanoid = humanoid
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESPHighlight"
    highlight.Adornee = character
    highlight.FillColor = getgenv().EspColor
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = true
    highlight.Parent = character

    data.Highlight = highlight
    
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESPInfo"
    billboard.Adornee = head
    billboard.Size = UDim2.fromOffset(200, 45)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = true
    billboard.Parent = character

    data.Billboard = billboard

    local nameLabel = Instance.new("TextLabel")
    nameLabel.BackgroundTransparency = 1
    nameLabel.Size = UDim2.new(1, 0, 0, 20)
    nameLabel.Font = Enum.Font.SourceSansBold
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextSize = 14
    nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.Parent = billboard

    local distanceLabel = Instance.new("TextLabel")
    distanceLabel.BackgroundTransparency = 1
    distanceLabel.Position = UDim2.fromOffset(0, 20)
    distanceLabel.Size = UDim2.new(1, 0, 0, 18)
    distanceLabel.Font = Enum.Font.SourceSansBold
    distanceLabel.Text = "[0 studs]"
    distanceLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
    distanceLabel.TextSize = 12
    distanceLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    distanceLabel.TextStrokeTransparency = 0
    distanceLabel.Parent = billboard
    
    local box = Instance.new("Frame")
    box.Name = player.Name .. "_ESPBox"
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 0
    box.Visible = false
    box.Parent = EspGui

    data.Box = box

    local boxStroke = Instance.new("UIStroke")
    boxStroke.Thickness = 1.5
    boxStroke.Color = getgenv().EspColor
    boxStroke.Parent = box
    
    local tracer = Instance.new("Frame")
    tracer.Name = player.Name .. "_ESPTracer"
    tracer.BackgroundTransparency = 1
    tracer.BorderSizePixel = 0
    tracer.Size = UDim2.fromScale(1, 1)
    tracer.Visible = false
    tracer.Parent = TracerGui

    data.Tracer = tracer
    
    local tracerShadow = Instance.new("Frame")
    tracerShadow.Name = "Shadow"
    tracerShadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    tracerShadow.BackgroundTransparency = 0.65
    tracerShadow.BorderSizePixel = 0
    tracerShadow.AnchorPoint = Vector2.new(0.5, 0.5)
    tracerShadow.ZIndex = 1
    tracerShadow.Parent = tracer
    
    local tracerLine = Instance.new("Frame")
    tracerLine.Name = "Line"
    tracerLine.BackgroundColor3 = getgenv().EspColor
    tracerLine.BorderSizePixel = 0
    tracerLine.AnchorPoint = Vector2.new(0.5, 0.5)
    tracerLine.ZIndex = 2
    tracerLine.Parent = tracer

    data.RenderConnection = RunService.RenderStepped:Connect(function()
        if not getgenv().EspEnabled then
            highlight.Enabled = false
            billboard.Enabled = false
            box.Visible = false
            tracer.Visible = false
            return
        end

        if player.Character ~= character
            or not character:IsDescendantOf(workspace)
            or humanoid.Health <= 0
        then
            highlight.Enabled = false
            billboard.Enabled = false
            box.Visible = false
            tracer.Visible = false
            return
        end
        
        local currentRoot, currentHead = getAvatarParts(character)

        if currentRoot then
            rootPart = currentRoot
            data.RootPart = currentRoot
        end

        if currentHead then
            head = currentHead
            data.Head = currentHead

            if billboard.Adornee ~= currentHead then
                billboard.Adornee = currentHead
            end
        end

        if not rootPart then
            box.Visible = false
            tracer.Visible = false
            return
        end

        local myCharacter = LocalPlayer.Character

        if not myCharacter then
            box.Visible = false
            tracer.Visible = false
            return
        end

        local myRoot =
            myCharacter:FindFirstChild("HumanoidRootPart")
            or myCharacter.PrimaryPart

        if not myRoot then
            box.Visible = false
            tracer.Visible = false
            return
        end

        local camera = getCamera()

        if not camera then
            return
        end

        local color = getgenv().EspColor

        highlight.FillColor = color
        boxStroke.Color = color
        tracerLine.BackgroundColor3 = color
        
        local boundingCFrame, boundingSize =
            character:GetBoundingBox()

        local boundsCenter = boundingCFrame.Position

        local distance =
            (myRoot.Position - boundsCenter).Magnitude

        distanceLabel.Text =
            "[" .. math.floor(distance) .. " studs]"

        highlight.Enabled = true
        billboard.Enabled = true

        if distance > 1000 then
            box.Visible = false
            tracer.Visible = false
            return
        end
        
        local topWorld =
            boundsCenter +
            Vector3.new(0, boundingSize.Y / 2, 0)

        local bottomWorld =
            boundsCenter -
            Vector3.new(0, boundingSize.Y / 2, 0)

        local topScreen =
            camera:WorldToViewportPoint(topWorld)

        local bottomScreen =
            camera:WorldToViewportPoint(bottomWorld)

        if topScreen.Z <= 0 or bottomScreen.Z <= 0 then
            box.Visible = false
            tracer.Visible = false
            return
        end

        local height =
            math.abs(bottomScreen.Y - topScreen.Y)

        local width =
            math.max(height * 0.55, 2)

        if height < 2 then
            box.Visible = false
        else
            box.Size =
                UDim2.fromOffset(width, height)

            box.Position =
                UDim2.fromOffset(
                    bottomScreen.X - width / 2,
                    topScreen.Y
                )

            box.Visible = true
        end
         
        local feetScreen, feetVisible =
            camera:WorldToViewportPoint(bottomWorld)

        if not feetVisible or feetScreen.Z <= 0 then
            tracer.Visible = false
            return
        end

        local startX =
            camera.ViewportSize.X / 2

        local startY =
            camera.ViewportSize.Y

        local endX = feetScreen.X
        local endY = feetScreen.Y

        local dx = endX - startX
        local dy = endY - startY

        local lineLength =
            math.sqrt(dx * dx + dy * dy)

        if lineLength <= 1 then
            tracer.Visible = false
            return
        end

        local angle =
            math.deg(math.atan2(dy, dx))

        local centerX =
            (startX + endX) / 2

        local centerY =
            (startY + endY) / 2
        
        tracerLine.Size =
            UDim2.fromOffset(lineLength, 2)

        tracerLine.Position =
            UDim2.fromOffset(centerX, centerY)

        tracerLine.Rotation = angle
        
        tracerShadow.Size =
            UDim2.fromOffset(lineLength, 4)

        tracerShadow.Position =
            UDim2.fromOffset(centerX, centerY)

        tracerShadow.Rotation = angle

        tracer.Visible = true
    end)
end

local function setupPlayer(player)
    if player == LocalPlayer then
        return
    end

    local data = getgenv().ESPData[player]

    if not data then
        data = {}
        getgenv().ESPData[player] = data
    end

    if data.CharacterConnection then
        data.CharacterConnection:Disconnect()
        data.CharacterConnection = nil
    end

    data.CharacterConnection =
        player.CharacterAdded:Connect(function(character)
            
            local deadline = os.clock() + 5

            repeat
                task.wait(0.1)

                if not getgenv().EspEnabled
                    or player.Character ~= character
                then
                    return
                end

                if character:FindFirstChildOfClass("Humanoid")
                    and character:FindFirstChildWhichIsA("BasePart", true)
                then
                    break
                end

            until os.clock() >= deadline

            if getgenv().EspEnabled
                and player.Character == character
            then
                createESP(player, character)
            end
        end)

    if player.Character then
        task.spawn(function()
            local character = player.Character
            local deadline = os.clock() + 5

            repeat
                task.wait(0.1)

                if not getgenv().EspEnabled
                    or player.Character ~= character
                then
                    return
                end

                if character:FindFirstChildOfClass("Humanoid")
                    and character:FindFirstChildWhichIsA("BasePart", true)
                then
                    break
                end

            until os.clock() >= deadline

            if getgenv().EspEnabled
                and player.Character == character
            then
                createESP(player, character)
            end
        end)
    end
end

getgenv().EnableESP = function()
    getgenv().EspEnabled = true

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            setupPlayer(player)
        end
    end
end

getgenv().DisableESP = function()
    getgenv().EspEnabled = false

    for player in pairs(getgenv().ESPData) do
        cleanupPlayer(player)
    end
end

getgenv().RefreshESP = function()
    if not getgenv().EspEnabled then
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local data = getgenv().ESPData[player]

            if not data then
                setupPlayer(player)

            elseif data.Character ~= player.Character
                and player.Character
            then
                createESP(player, player.Character)
            end
        end
    end
end

