local function destroyVisuals(data)
    if not data then
        return
    end

    if data.RenderConnection then
        data.RenderConnection:Disconnect()
        data.RenderConnection = nil
    end

    if data.Highlight then
        data.Highlight:Destroy()
        data.Highlight = nil
    end

    if data.Billboard then
        data.Billboard:Destroy()
        data.Billboard = nil
    end

    if data.Box then
        data.Box:Destroy()
        data.Box = nil
    end

    if data.Tracer then
        data.Tracer:Destroy()
        data.Tracer = nil
    end
end

local function cleanupPlayer(player)
    local data = getgenv().ESPData[player]

    if not data then
        return
    end

    destroyVisuals(data)

    if data.CharacterConnection then
        data.CharacterConnection:Disconnect()
        data.CharacterConnection = nil
    end

    getgenv().ESPData[player] = nil
end

local function getAvatarParts(character)
    if not character then
        return nil, nil
    end

    local root =
        character:FindFirstChild("HumanoidRootPart")
        or character.PrimaryPart

    local head = character:FindFirstChild("Head")
    
    if not root or not root:IsA("BasePart") then
        root = nil

        for _, obj in ipairs(character:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Transparency < 1 then
                root = obj
                break
            end
        end
    end
    
    if not head or not head:IsA("BasePart") then
        head = root
    end

    return root, head
end

local function createESP(player, character)
